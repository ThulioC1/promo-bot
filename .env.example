# Copie este arquivo para .env e preencha os valores
# (o bot carrega variaveis do .env automaticamente)

# Token do bot (do @BotFather)
TELEGRAM_TOKEN=8386299152:AAGx4x-Ea53K338wa4klDJvRsRqbTC1link

# ID do grupo/canal do Telegram (numero negativo, ex: -1001234567890)
# Dica: use @RawDataBot ou @userinfobot para descobrir o ID do grupo
TELEGRAM_CHAT_ID=-1003538321515

# Fonte de dados: mercadolivre | pelando | rss
# (Pelando desativou a API em 2026; mercadolivre e a recomendada)
SOURCE=mercadolivre

# Termos de busca (mercadolivre e pelando-busca). Ex: notebook,celular,fone
# Deixe vazio no mercadolivre para buscar produtos em geral
SEARCH_TERMS=
CHANNEL=ofertas

# Desconto minimo (%) para postar. 0 = posta tudo
MIN_DISCOUNT=0

# Palavras no titulo que fazem a oferta ser IGNORADA (separadas por virgula).
# Ex: frete gratis,edicao limitada
BLOCK_WORDS=

# Intervalo entre varreduras (segundos)
INTERVAL=300

# So usado quando SOURCE=rss (URL de um feed RSS de promocoes)
FEED_URL=

# --- Afiliados (deixe vazio para desativar) ---
# Amazon Associates: seu tracking id (ex: meinebot-20)
AMAZON_TAG=vagantepromoc-20
# Mercado Livre: sufixo de PATH do painel de afiliados ML
# (ex: social/coth8154082  ->  cole o que aparece apos o produto)
ML_AFFILIATE=social/coth8154082
# Shopee: sufixo de tracking do painel de afiliados Shopee
SHOPEE_AFFILIATE=
# Magazine Luiza: sufixo de afiliado (ex: via Awin)
MAGAZINE_AFFILIATE=
# Americanas: sufixo de afiliado (ex: via Lomadee)
AMERICANAS_AFFILIATE=
# Rodape de divulgacao (compliance). Edite para personalizar ou deixe vazio para remover.
FOOTER=🔗 Links afiliados: posso ganhar comissao sem custo extra para voce.

